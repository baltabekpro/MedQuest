# Backend environment variables
# Copy to .env and fill in values before starting

# REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Database (SQLite by default — suitable for single-instance VPS deployment)
DATABASE_URL=sqlite:////opt/medquest/backend/medquest.db

# Extra CORS origins (comma-separated). *.vercel.app is already whitelisted via regex.
# Add your production Vercel domain here if needed.
CORS_ORIGINS=
