[Unit]
Description=MedQuest FastAPI Backend
After=network.target

[Service]
Type=exec
User=work
WorkingDirectory=/opt/medquest/backend
EnvironmentFile=/opt/medquest/backend/.env
ExecStart=/opt/medquest/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
